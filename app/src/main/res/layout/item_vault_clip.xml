<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:strokeColor="#1FFFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClipMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Circle OCR • Just now"
                android:textColor="@color/accent_glow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClipContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnVaultPin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pin"
            android:padding="6dp"
            android:src="@drawable/ic_pin" />

        <ImageButton
            android:id="@+id/btnVaultCopy"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy"
            android:padding="6dp"
            android:src="@drawable/ic_copy" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
